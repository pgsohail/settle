PORT=8000
BASE_URL=http://localhost:8000
DATABASE_PATH=./settle.db
TIMEZONE=Europe/London
ENGINE_INTERVAL=900

# Xero (developer.xero.com)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# QuickBooks Online (developer.intuit.com)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# WhatsApp Cloud API (developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_TEMPLATE=invoice_reminder

# Email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_DOMAIN=

# Reply agent (optional; requires `pip install anthropic`)
ANTHROPIC_API_KEY=
